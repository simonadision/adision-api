# Copier ce fichier en .env.local.ps1 (NON suivi par git) et y mettre vos valeurs LOCALES.
# run_local.ps1 source ce fichier au lancement. AUCUN secret ne doit vivre dans un fichier suivi.
$env:DATABASE_URL = "postgresql://postgres:<motdepasse-local>@localhost:5432/adision"
$env:JWT_SECRET   = "<jwt-secret-local-dev>"
