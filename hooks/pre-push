#!/bin/sh
# Hook pré-push Ad BUD (adision-api) — bloque le push si un chemin PDF casse.
# Installer une fois :  git config core.hooksPath hooks
#
# Tests des chemins critiques : rapport de calcul (sans/avec client/vide),
# devis, snapshot, émission HUB, + garde anti-régression du 500 NameError.
set -e
echo "[pre-push] Tests PDF critiques (rapport/devis/émission)…"
if ! python tests/test_pdf_critical.py; then
  echo "[pre-push] ÉCHEC des tests PDF — push BLOQUÉ." >&2
  exit 1
fi
# Divergences écran↔rapport connues (D3/D4) : tests ATTENDUS-EN-ÉCHEC (xfail).
# Exit 0 tant que le défaut est présent (attendu) ; exit 1 en XPASS = un défaut
# documenté a été corrigé sans retirer le marqueur → mettre le fichier à jour.
echo "[pre-push] Divergences écran↔rapport (D3/D4, xfail strict)…"
if ! python tests/test_divergences_ecran_rapport.py; then
  echo "[pre-push] XPASS inattendu — un défaut D3/D4 a changé, MAJ du test requise." >&2
  exit 1
fi
# Fidélité devis jsPDF↔reportlab (Option B). NON BLOQUANT tant que la bascule
# n'est pas faite (bascule.json : default_engine='reportlab', strict=false) :
# reportlab reste le moteur SERVI, on ne bloque pas le push sur la dérive jsPDF.
# Devient BLOQUANT le jour de la bascule (strict=true / default_engine='jspdf').
# `|| true` filet si node/monorepo indisponibles (le script gère aussi le SKIP).
echo "[pre-push] Fidélité devis jsPDF↔reportlab (Option B)…"
python tests/test_devis_fidelity.py || echo "[pre-push] (harnais fidélité : coexistence/indispo — non bloquant)"
echo "[pre-push] OK — chemins critiques verts."
