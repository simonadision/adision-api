#!/bin/sh
# Hook pré-push Ad BUD (adision-api) — bloque le push si un chemin PDF casse.
# Installer une fois :  git config core.hooksPath hooks
#
# Tests des chemins critiques : rapport de calcul (sans/avec client/vide),
# devis, snapshot, émission HUB, + garde anti-régression du 500 NameError.
set -e
echo "[pre-push] Tests PDF critiques (rapport/devis/émission)…"
if ! python tests/test_pdf_critical.py; then
  echo "[pre-push] ÉCHEC des tests PDF — push BLOQUÉ." >&2
  exit 1
fi
# Divergences écran↔rapport connues (D3/D4) : tests ATTENDUS-EN-ÉCHEC (xfail).
# Exit 0 tant que le défaut est présent (attendu) ; exit 1 en XPASS = un défaut
# documenté a été corrigé sans retirer le marqueur → mettre le fichier à jour.
echo "[pre-push] Divergences écran↔rapport (D3/D4, xfail strict)…"
if ! python tests/test_divergences_ecran_rapport.py; then
  echo "[pre-push] XPASS inattendu — un défaut D3/D4 a changé, MAJ du test requise." >&2
  exit 1
fi
# Contrat GET /devis (plomberie) — attrape « champ non exposé » / « source
# divergente » / « mauvaise org » (le harnais de rendu ne peut pas les voir).
# Sans réseau -> toujours bloquant.
echo "[pre-push] Contrat GET /devis (plomberie)…"
if ! python tests/test_devis_contract.py; then
  echo "[pre-push] ÉCHEC contrat GET /devis — push BLOQUÉ." >&2
  exit 1
fi
# Émission RELAIS du devis (Option B) : sanity %PDF, empreinte, divergence, relais
# des octets client. Sans réseau (post_report monkeypatché) -> toujours bloquant.
echo "[pre-push] Émission relais devis (sanity/empreinte/divergence)…"
if ! python tests/test_devis_emit_relay.py; then
  echo "[pre-push] ÉCHEC émission relais devis — push BLOQUÉ." >&2
  exit 1
fi
# Fidélité devis jsPDF↔reportlab (Option B). BASCULÉ : jsPDF est le moteur SERVI
# (bascule.json strict=true) -> le harnais BLOQUE si un témoin sort de la
# tolérance. Le script gère lui-même le report-only si strict=false (avant
# bascule). Garde node/monorepo : on ne bloque pas un env qui n'a pas de quoi
# rendre le jsPDF (sinon faux blocage), mais on bloque bien sur une VRAIE dérive.
if command -v node >/dev/null 2>&1 && [ -d "../adision-monorepo/packages/devis-pdf" ]; then
  echo "[pre-push] Fidélité devis jsPDF↔reportlab (moteur servi)…"
  if ! python tests/test_devis_fidelity.py; then
    echo "[pre-push] ÉCHEC fidélité devis (moteur servi = jsPDF) — push BLOQUÉ." >&2
    exit 1
  fi
  # Fidélité RAPPORT jsPDF↔reportlab. BASCULÉ le 2026-07-21 : jsPDF est le moteur
  # SERVI du rapport (bascule.json default_engine=jspdf, strict=true).
  #
  # ⚠️ CE BLOC MANQUAIT. bascule.json était passé à strict=true, mais le hook
  # n'appelait QUE le harnais du DEVIS : le portillon du rapport ne s'exécutait
  # jamais au push et ne bloquait donc RIEN. Un drapeau « bloquant » que la
  # chaîne n'exécute pas est un gate DÉCORATIF — exactement le défaut corrigé
  # sur le devis. Le script gère lui-même le report-only si strict=false.
  # Blocage PROUVÉ EN SITUATION le 2026-07-21 : régression volontaire dans le
  # moteur (FRAME_PAD 6 -> 15) -> ce hook a refusé le push ; moteur restauré ->
  # push accepté. Le gate n'est pas supposé bloquant, il a été vu bloquer.
  echo "[pre-push] Fidélité rapport jsPDF↔reportlab (moteur servi)…"
  if ! python tests/test_report_fidelity.py; then
    echo "[pre-push] ÉCHEC fidélité rapport (moteur servi = jsPDF) — push BLOQUÉ." >&2
    exit 1
  fi
  # Accord cross-langage de l'EMPREINTE budget (Python == JS). Si les deux
  # implémentations divergent d'un octet, toute émission signalerait une fausse
  # dérive -> bloquant (même garde node/monorepo).
  echo "[pre-push] Accord empreinte budget Python↔JS…"
  if ! python tests/test_budget_fingerprint_agreement.py; then
    echo "[pre-push] ÉCHEC accord empreinte budget (Python != JS) — push BLOQUÉ." >&2
    exit 1
  fi
else
  echo "[pre-push] (node/monorepo absent — fidélité devis+rapport et accord empreinte sautés, non bloquant)"
fi
echo "[pre-push] OK — chemins critiques verts."
