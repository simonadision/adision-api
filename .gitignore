# ─── Secrets & env ─────────────────────────────────────────────────────
# Tout fichier .env sauf .env.example qui sert de doc.
.env
.env.*
!.env.example

# Notes locales contenant des clés API en clair (jamais commiter).
# Pattern large pour attraper les futurs fichiers secrets ad-hoc.
*api-key*.txt
*api_key*.txt
*-key.txt
*_KEY.txt
*secret*.txt
*SECRET*.txt
Clé*.txt
*.key
secrets/
# Fichiers connus (au cas où le pattern ci-dessus rate).
Clé Claude API.txt
JWT_SECRET Adision.txt
scraper/serpapi-key.txt

# ─── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ─── Virtual envs (le repo en contient deux par accident) ─────────────
.venv/
venv/
env/
# Layouts venv Windows à la racine du repo et dans scraper/
Lib/
Include/
Scripts/
pyvenv.cfg

# ⚠ `Scripts/` ci-dessus vise le venv Windows — mais git tourne ici avec
# core.ignorecase=true, donc il attrapait AUSSI `scripts/`, le dossier des
# scripts de validation du projet. Resultat : 29 scripts de preuve invisibles,
# dont ceux que des messages de commit citaient comme preuve. Un « 8/8 PASS »
# qui renvoie a un fichier absent du depot ne prouve rien a personne d'autre.
# On re-inclut le dossier, on re-ignore son contenu, puis on garde les seuls
# validate_* — ceux que CLAUDE.md exige avant un livre.
!scripts/
scripts/*
!scripts/validate_*.py
scraper/Lib/
scraper/Include/
scraper/Scripts/
scraper/pyvenv.cfg

# ─── OS / éditeurs ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# Scripts perso avec secrets en clair (TODO: refactorer pour utiliser .env)
import_railway.py
import_budget.py

# secrets locaux (scrub Chantier 1)
.env.local.ps1
!.env.local.ps1.example
